#:import dp kivy.metrics.dp

<M3Card>:
    orientation: "vertical"
    padding: dp(16)
    spacing: dp(8)

<M3TopAppBar>:
    padding: [dp(4), 0, dp(12), 0]
    spacing: dp(4)

<M3SearchBar>:
    padding: [dp(4), 0, dp(12), 0]
    spacing: dp(4)

<M3NavigationBar>:
    padding: dp(8)
    spacing: dp(4)
